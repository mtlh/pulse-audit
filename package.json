{
  "name": "@mtlh/pulse-audit",
  "version": "0.2.1",
  "description": "Performance, accessibility and page-weight budgets that survive CI.",
  "type": "module",
  "license": "MIT",
  "author": "Matthew Harvey",
  "homepage": "https://github.com/mtlh/pulse-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtlh/pulse-audit.git"
  },
  "bugs": {
    "url": "https://github.com/mtlh/pulse-audit/issues"
  },
  "keywords": [
    "performance",
    "lighthouse",
    "budgets",
    "accessibility",
    "web-vitals",
    "page-weight",
    "ci"
  ],
  "bin": {
    "pulse": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:flows": "npm run build",
    "test:flows": "vitest run --config vitest.flows.config.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "prebattle-test": "npm run build",
    "battle-test": "node scripts/battle-test.mjs",
    "prebench": "npm run build",
    "bench": "node scripts/bench.mjs",
    "test:watch": "vitest",
    "size:report": "node scripts/size-report.mjs",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "puppeteer-core": "^25.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "axe-core": "4.14.1",
    "chrome-launcher": "^1.2.3",
    "commander": "^15.1.0",
    "eslint": "^10.16.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
